# ─────────────────────────────────────────────────────────────
# Environment — PoC QR Traceability System
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Node environment (development | production)
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sankei_db
POSTGRES_USER=sankei_user
POSTGRES_PASSWORD=sankei_password
DATABASE_URL=postgres://sankei_user:sankei_password@localhost:5432/sankei_db

# ─────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────
BACKEND_PORT=3000

# ─────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
