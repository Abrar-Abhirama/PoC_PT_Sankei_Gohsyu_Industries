{
  "name": "sankei-backend",
  "version": "1.0.0",
  "description": "Node.js + TypeScript + Express backend for the PoC QR Traceability System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "migrate:up": "ts-node-dev --transpile-only src/scripts/migrate.ts up",
    "migrate:down": "ts-node-dev --transpile-only src/scripts/migrate.ts down",
    "mock:ipc": "node ../mock-ipc/index.js",
    "mock:opc:ok": "node ../mock-opc-client/index.js --ok",
    "mock:opc:ng": "node ../mock-opc-client/index.js --ng",
    "mock:opc:periodic": "node ../mock-opc-client/index.js --periodic"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
